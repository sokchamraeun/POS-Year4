# Local dev: Laravel storage URL
# Production: change to your S3 bucket URL, Render storage URL, or Cloudinary base URL
# Note: When using Cloudinary, product.image will be a full URL, so VITE_STORAGE_URL is only used for local/legacy images
VITE_STORAGE_URL=http://localhost:8000/storage

# API base URL
VITE_API_URL=http://localhost:8000/api
